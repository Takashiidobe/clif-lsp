function %f(i32, i32) -> i32 {
block0(v0: i32, v1: i32):
    v2 = iadd v0, v1
    brif v0, block1, block2
block1:
    v3 = iadd v2, v1
    jump block3(v3)
block2:
    jump block3(v2)
block3(v4: i32):
    v5 = iadd v4, v0
    return v5
}
