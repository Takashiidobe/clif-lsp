function %f(i32) -> i32 {
    ss0 = explicit_slot 8
block0(v0: i32):
    v1 = iadd.i32 v0, v0 ; add
    v2 = icmp eq v1, v0
    v3 = iconst.i32 0x10
    v4 = call %g(v3)
    trapnz v2, user1
    return v1
}
