; mode: view, lsp
; ^ view analysis
; ^ view analysis %g
; lsp: open
; lsp: request clif/view {"view":"analysis"}
; check: view analysis
; check: title: Analysis of %f
; check: == Dominator tree ==
; nextln: block0
; nextln: block1
; nextln: block2
; nextln: block3
; check: == Blocks ==
; check: block3 | block0 | block1, block2
; check: == Values ==
; check: v1 | block0 | block1 | block0
; check: view analysis %g
; check: title: Analysis of %g
; check: clif/view -> {"function":"%f"
function %f(i32, i32) -> i32 {
block0(v0: i32, v1: i32):
    v2 = iadd v0, v1
    brif v0, block1, block2
block1:
    v3 = iadd v2, v1
    jump block3(v3)
block2:
    jump block3(v2)
block3(v4: i32):
    v5 = iadd v4, v0
    return v5
}
function %g() {
block0:
    return
}
