; mode: view
; ^ view provenance %fold
; ^ view provenance %gvn
; ^ view provenance %identity
; check: view provenance %fold
; check: title: Optimization provenance of %fold
; check: input instructions | 5
; check: == Provenance map ==
; nextln: (html page)
; check: iconst.i64 84 | new | no provenance available
; check: | changed | v4 = iadd.i64 v0, v3
; check: return v4 | unchanged | return v4
; check: == No longer present ==
; nextln: input instruction
; nextln: v1 = iconst.i64 42
; check: view provenance %gvn
; check: no longer present | 1
; check: == No longer present ==
; nextln: input instruction
; nextln: v3 = iadd.i64 v0, v1
; check: view provenance %identity
; check: v2 = iadd
set opt_level=speed
target x86_64
function %fold(i64) -> i64 {
block0(v0: i64):
    v1 = iconst.i64 42
    v2 = iconst.i64 2
    v3 = imul v1, v2
    v4 = iadd v0, v3
    return v4
}
function %gvn(i64, i64) -> i64 {
block0(v0: i64, v1: i64):
    v2 = iadd v0, v1
    v3 = iadd v0, v1
    v4 = imul v2, v3
    return v4
}
function %identity(i64) -> i64 {
block0(v0: i64):
    v1 = iconst.i64 0
    v2 = iadd v0, v1
    return v2
}
