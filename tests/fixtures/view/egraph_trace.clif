; mode: egraph-trace
; check: returned from ISLE: v2 -> [v4]
; check: v5 = Union(v2, v4)
; check: cost of value v2 = Cost::Finite(11)
; check: cost of value v4 = Cost::Finite(4)
; check: elaborate: value v5 -> best v4
set opt_level=speed
target x86_64
function %f(i64) -> i64 {
block0(v0: i64):
    v1 = iconst.i64 8
    v2 = imul v0, v1
    return v2
}
