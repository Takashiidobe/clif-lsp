; mode: view, lsp
; ^ view cfg
; ^ view cfg %g
; ^ view cfg %missing
; ^ view nope
; lsp: open
; lsp: request clif/view {"view":"cfg","function":"%g"}
; lsp: request clif/view {"view":"nope"}
; check: view cfg
; check: title: Control flow of %f
; check: == Graph ==
; nextln: (html page)
; check: == Blocks ==
; nextln: block | successors | reachable
; nextln: block0 | block1, block2 | yes
; check: block3 |
; sameln: | no
; check: view cfg %g
; check: title: Control flow of %g
; check: view cfg %missing
; nextln: error: no function `%missing`
; check: view nope
; nextln: error: unknown view `nope`, expected one of: cfg, analysis, def_use, use_counts, live_ranges, stage, allocators, regalloc, provenance, egraph
; check: clif/view -> {"function":"%g"
; nextln: clif/view -> error -32602 unknown view `nope`, expected one of: cfg, analysis, def_use, use_counts, live_ranges, stage, allocators, regalloc, provenance, egraph
function %f(i32) {
block0(v0: i32):
    brif v0, block1, block2
block1:
    return
block2:
    return
block3:
    return
}
function %g() {
block0:
    return
}
