; mode: syntax-tree
; check: directive @0:0 test compile
; nextln: directive @1:0 target x86_64
; nextln: directive @2:0 set opt_level = speed
; nextln: function %main @4:0 closed
; nextln: signature (i32, i64 sext) -> (i32 uext)
; nextln: call_conv tail
; nextln: decl sig0 @5:4 = ( i32 ) -> i32
; nextln: decl fn0 @6:4 = %helper sig0
; nextln: decl ss0 @7:4 = explicit_slot 8
; nextln: block block0 @8:0
; nextln: param v0 : i32
; nextln: param v1 : i64
; nextln: inst @9:4 v2 v3 = isplit v0
; nextln: inst @10:4 v4 = call fn0 ( v2 )
; nextln: inst @11:4 brif v4 , block1 ( v4 ) , block2
; nextln: block block1 @12:0
; nextln: param v5 : i32
; nextln: inst @13:4 return v5
; nextln: block block2 @14:0
; nextln: inst @15:4 v6 = iconst.i32 0
; nextln: inst @17:4 return v6
; nextln: errors:
; nextln: comments:
; nextln: directive comments
; nextln: @3:0 "; leading comment"
; nextln: @10:22 "; trailing comment"
; nextln: @16:0 "; between"
test compile
target x86_64
set opt_level=speed
; leading comment
function %main(i32, i64 sext) -> i32 uext tail {
    sig0 = (i32) -> i32
    fn0 = %helper sig0
    ss0 = explicit_slot 8
block0(v0: i32, v1: i64):
    v2, v3 = isplit v0
    v4 = call fn0(v2) ; trailing comment
    brif v4, block1(v4), block2
block1(v5: i32) cold:
    return v5
block2:
    v6 = iconst.i32 0
; between
    return v6
}
